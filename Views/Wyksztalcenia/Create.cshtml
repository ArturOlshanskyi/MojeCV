@model MojeCV.Models.Wyksztalcenie

@{
    ViewData["Title"] = "Create";
}

<h1>Dodaj</h1>

<h4>Wykształcenie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Uczelnia" class="control-label"></label>
                <input asp-for="Uczelnia" class="form-control" />
                <span asp-validation-for="Uczelnia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kierunek" class="control-label"></label>
                <input asp-for="Kierunek" class="form-control" />
                <span asp-validation-for="Kierunek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Poziom" class="control-label"></label>
                <input asp-for="Poziom" class="form-control" />
                <span asp-validation-for="Poziom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataOd" class="control-label"></label>
                <input asp-for="DataOd" class="form-control" />
                <span asp-validation-for="DataOd" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataDo" class="control-label"></label>
                <input asp-for="DataDo" class="form-control" />
                <span asp-validation-for="DataDo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Dodaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Powrót do listy</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
