@model MojeCV.Models.Film

@{
    ViewData["Title"] = "Dodaj film";
}

<header class="page-header">
    <h1>Dodaj film</h1>
</header>

<section class="form-card">
    <form asp-action="Create" id="film-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Tytul" class="form-label"></label>
            <input asp-for="Tytul" class="form-control" required />
            <span asp-validation-for="Tytul" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DlugoscMinuty" class="form-label"></label>
            <input asp-for="DlugoscMinuty" class="form-control" type="number" min="1" max="1440" required />
            <span asp-validation-for="DlugoscMinuty" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Rezyser" class="form-label"></label>
            <input asp-for="Rezyser" class="form-control" required />
            <span asp-validation-for="Rezyser" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Zapisz</button>
        <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
    </form>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
