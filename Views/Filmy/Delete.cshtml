@model MojeCV.Models.Film

@{
    ViewData["Title"] = "Usuń film";
}

<header class="page-header">
    <h1>Usuń film</h1>
</header>

<section class="form-card">
    <h2 class="h5">Czy na pewno chcesz usunąć ten film?</h2>

    <dl class="row mt-3">
        <dt class="col-sm-3">Tytuł</dt>
        <dd class="col-sm-9">@Model.Tytul</dd>
        <dt class="col-sm-3">Długość</dt>
        <dd class="col-sm-9">@Model.DlugoscMinuty minut</dd>
        <dt class="col-sm-3">Reżyser</dt>
        <dd class="col-sm-9">@Model.Rezyser</dd>
    </dl>

    <form asp-action="Delete" class="delete-form">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger confirm-delete">Usuń</button>
        <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
    </form>
</section>
