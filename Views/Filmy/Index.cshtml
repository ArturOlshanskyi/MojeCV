@model IEnumerable<MojeCV.Models.Film>

@{
    ViewData["Title"] = "Lista filmów";
}

<header class="page-header">
    <h1>Lista filmów</h1>
</header>

<section class="movies-section" aria-labelledby="lista-filmow">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 id="lista-filmow" class="h4 mb-0">Baza filmów</h2>
        <a asp-action="Create" class="btn btn-success">Dodaj film</a>
    </div>

    @if (TempData["Komunikat"] is string komunikat)
    {
        <div class="alert alert-success" role="alert">@komunikat</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Tytuł</th>
                    <th>Długość (minuty)</th>
                    <th>Reżyser</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var film in Model)
            {
                <tr>
                    <td>@film.Tytul</td>
                    <td>@film.DlugoscMinuty</td>
                    <td>@film.Rezyser</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@film.Id" class="btn btn-primary btn-sm">Edytuj</a>
                        <a asp-action="Delete" asp-route-id="@film.Id" class="btn btn-danger btn-sm">Usuń</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
