@model IEnumerable<MojeCV.Models.Reservation>
@{ ViewData["Title"] = "Panel administratora"; }
<div class="page-heading"><div><span class="eyebrow">Administracja</span><h1>Dashboard</h1></div></div>
<div class="stats-grid"><article><span>Aktywne rezerwacje</span><strong>@ViewBag.ActiveReservations</strong></article><article><span>Oczekujące</span><strong>@ViewBag.PendingReservations</strong></article><article><span>Aktywne usługi</span><strong>@ViewBag.ServicesCount</strong></article><article><span>Dzisiejsze</span><strong>@ViewBag.TodayReservations</strong></article></div>
<div class="admin-actions"><a asp-controller="AdminServices" asp-action="Index" class="btn btn-primary">Usługi</a><a asp-controller="AdminSlots" asp-action="Index" class="btn btn-outline-primary">Terminy</a></div>
<div class="table-responsive admin-table"><table class="table align-middle"><thead><tr><th>Klient</th><th>Usługa</th><th>Termin</th><th>Status</th><th>Akcje</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.User?.Email</td><td>@r.Service?.Name</td><td>@r.ReservationSlot?.StartTime.ToString("dd.MM.yyyy HH:mm")</td><td><span class="status-badge @(r.Status == MojeCV.Models.ReservationStatus.Approved ? "success" : r.Status == MojeCV.Models.ReservationStatus.Pending ? "warning" : "secondary")">@r.Status</span></td><td><div class="d-flex gap-1"><form asp-action="SetStatus" method="post"><input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="status" value="Approved" /><button class="btn btn-success btn-sm">Zatwierdź</button></form><form asp-action="SetStatus" method="post"><input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="status" value="Rejected" /><button class="btn btn-danger btn-sm">Odrzuć</button></form></div></td></tr>}</tbody></table></div>
