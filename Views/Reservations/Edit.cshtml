@model MojeCV.Models.Reservation
@{ ViewData["Title"] = "Edytuj rezerwację"; var slots = ViewBag.Slots as IEnumerable<MojeCV.Models.ReservationSlot>; }
<div class="page-heading"><div><span class="eyebrow">Edycja</span><h1>@Model.Service?.Name</h1></div></div>
<div class="form-card mx-auto reservation-form"><form asp-action="Edit" method="post"><input type="hidden" name="id" value="@Model.Id" /><fieldset class="mb-4"><legend class="form-label">Termin</legend><div class="slot-grid">@foreach(var slot in slots ?? Enumerable.Empty<MojeCV.Models.ReservationSlot>()){<label class="slot-option"><input type="radio" name="reservationSlotId" value="@slot.Id" @(slot.Id == Model.ReservationSlotId ? "checked" : "") /><span><strong>@slot.StartTime.ToString("dd.MM.yyyy")</strong><small>@slot.StartTime.ToString("HH:mm")</small></span></label>}</div></fieldset><div class="mb-3"><label for="notes" class="form-label">Notatka</label><textarea id="notes" name="notes" class="form-control" rows="3">@Model.Notes</textarea></div><button class="btn btn-primary w-100">Zapisz zmiany</button></form></div>
