@model IEnumerable<MojeCV.Models.ReservationSlot>
@{ ViewData["Title"] = "Terminy — administrator"; }
<div class="page-heading"><div><span class="eyebrow">Administracja</span><h1>Terminy dostępne do rezerwacji</h1></div><a asp-action="Create" class="btn btn-primary">Dodaj termin</a></div>
<div class="table-responsive admin-table"><table class="table align-middle"><thead><tr><th>Usługa</th><th>Data i godzina</th><th>Pojemność</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Service?.Name</td><td>@s.StartTime.ToString("dd.MM.yyyy HH:mm")</td><td>@s.Capacity</td><td>@(s.IsAvailable ? "Dostępny" : "Niedostępny")</td><td><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@s.Id" /><button class="btn btn-outline-danger btn-sm confirm-delete">Usuń</button></form></td></tr>}</tbody></table></div>
