<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Studio Rezerwacji</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark main-navbar" aria-label="Główna nawigacja">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">SR</span> Studio Rezerwacji</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Przełącz nawigację">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Services" asp-action="Index">Usługi</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Reservations" asp-action="Index">Moje rezerwacje</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Panel admina</a></li>
                            }
                            <li class="nav-item ms-lg-2">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button class="btn btn-outline-light btn-sm" type="submit">Wyloguj</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Logowanie</a></li>
                            <li class="nav-item ms-lg-2"><a class="btn btn-accent btn-sm" asp-controller="Account" asp-action="Register">Zarejestruj się</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container"><span>&copy; @DateTime.Now.Year Studio Rezerwacji</span><span>Rezerwuj wygodnie i szybko</span></div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
